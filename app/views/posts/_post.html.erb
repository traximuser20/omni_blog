<article id="<%= dom_id post %>" class="group flex h-full flex-col overflow-hidden rounded-3xl border border-stone-200/80 bg-white shadow-sm transition-all duration-300 hover:-translate-y-1.5 hover:shadow-xl hover:shadow-stone-900/10">
  <%= link_to post, class: "cover-texture relative flex h-44 items-center justify-center bg-gradient-to-br #{cover_gradient(post)}" do %>
    <span class="relative z-10 font-display text-6xl font-bold text-white/90 drop-shadow-md transition-transform duration-500 group-hover:scale-110"><%= post.title.to_s.first&.upcase || "O" %></span>
    <span class="absolute left-4 top-4 z-10 rounded-full bg-white/15 px-3 py-1 font-mono text-[10px] uppercase tracking-[0.18em] text-white backdrop-blur-md"><%= post.created_at.strftime("%b %d") %></span>
    <span class="absolute bottom-4 right-4 z-10 rounded-full bg-black/25 px-3 py-1 text-[11px] font-medium text-white backdrop-blur-md"><%= reading_time(post) %></span>
  <% end %>

  <div class="flex flex-1 flex-col p-6">
    <p class="mb-2 font-mono text-[10px] uppercase tracking-[0.2em] text-orange-600"><%= post.created_at.strftime("%B %d, %Y") %></p>
    <%= link_to post do %>
      <h3 class="font-display text-[1.4rem] font-semibold leading-snug tracking-tight text-stone-900 transition-colors group-hover:text-orange-700 line-clamp-2"><%= post.title %></h3>
    <% end %>
    <p class="mt-2.5 flex-1 text-[0.92rem] leading-relaxed text-stone-500 line-clamp-3"><%= post_excerpt(post) %></p>

    <div class="mt-5 flex items-center gap-2.5 border-t border-stone-100 pt-5">
      <span class="grid h-8 w-8 place-items-center rounded-full bg-stone-900 text-[10px] font-bold text-white"><%= author_initials(post) %></span>
      <span class="text-xs font-medium text-stone-500">OmniBlog Team</span>
      <span class="ml-auto flex items-center gap-1">
        <%= link_to "Read", post, class: "rounded-full bg-stone-900/[0.04] px-3.5 py-1.5 text-xs font-semibold text-stone-900 transition-colors hover:bg-stone-900 hover:text-white" %>
        <%= link_to edit_post_path(post), title: "Edit", class: "grid h-8 w-8 place-items-center rounded-full text-stone-400 transition-colors hover:bg-stone-100 hover:text-stone-900" do %>
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931z"/></svg>
        <% end %>
        <%= button_to post, method: :delete, title: "Delete", data: { turbo_confirm: "Delete “#{post.title}”? This can't be undone." }, class: "grid h-8 w-8 cursor-pointer place-items-center rounded-full text-stone-400 transition-colors hover:bg-red-50 hover:text-red-600" do %>
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0"/></svg>
        <% end %>
      </span>
    </div>
  </div>
</article>
