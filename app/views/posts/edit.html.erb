<% content_for :title, "Editing · #{@post.title}" %>

<div class="mx-auto max-w-3xl animate-rise">
  <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-orange-600">Editing</p>
  <h1 class="mt-2 font-display text-4xl font-semibold tracking-tight text-stone-900 line-clamp-2 sm:text-5xl"><%= @post.title %></h1>
  <p class="mt-3 text-stone-500">Polish it while it's fresh — every story deserves a second pass.</p>

  <div class="mt-8 rounded-3xl border border-stone-200/80 bg-white/80 p-6 shadow-xl shadow-stone-900/[0.05] backdrop-blur sm:p-10">
    <%= render "form", post: @post %>
  </div>

  <div class="mt-6 flex items-center justify-center gap-4 text-sm">
    <%= link_to "View story", @post, class: "rounded-full border border-stone-300 bg-white px-5 py-2.5 font-semibold text-stone-700 transition-all hover:border-stone-900 hover:text-stone-900" %>
    <%= link_to "← Back to all stories", posts_path, class: "font-medium text-stone-500 transition-colors hover:text-stone-900" %>
  </div>
</div>
