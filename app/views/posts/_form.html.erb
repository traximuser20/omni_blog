<%= form_with(model: post, class: "space-y-6", data: { controller: "post-form" }) do |form| %>
  <% if post.errors.any? %>
    <div class="flex gap-4 rounded-2xl border border-red-200 bg-red-50/80 p-5 text-red-900 shadow-sm" role="alert">
      <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-red-500 text-sm font-bold text-white">!</span>
      <div>
        <h2 class="font-semibold"><%= pluralize(post.errors.count, "error") %> kept this story from saving:</h2>
        <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-red-700">
          <% post.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="group">
    <%= form.label :title, "Story title", class: "mb-2 flex items-center justify-between text-sm font-semibold text-stone-700" do %>
      Story title
      <span class="font-mono text-[11px] font-normal text-stone-400" data-post-form-target="titleCount">0 / 120</span>
    <% end %>
    <%= form.text_field :title, maxlength: 120, placeholder: "A title worth clicking…",
      data: { post_form_target: "title", action: "input->post-form#update" },
      class: "block w-full rounded-2xl border border-stone-200 bg-white/80 px-5 py-4 font-display text-xl font-medium tracking-tight text-stone-900 shadow-sm backdrop-blur transition-all placeholder:font-sans placeholder:text-base placeholder:font-normal placeholder:text-stone-400 hover:border-stone-300 focus:border-orange-500 focus:outline-none focus:ring-4 focus:ring-orange-500/15" %>
  </div>


  <div>
    <%= form.label :subtitle, "Subtitle", class: "mb-2 block text-sm font-semibold text-stone-700" %>
    <%= form.text_field :subtitle, class: "block w-full rounded-2xl border border-stone-200 bg-white/80 px-5 py-3 focus:border-orange-500 focus:outline-none focus:ring-4 focus:ring-orange-500/15" %>
  </div>

  <div>
    <%= form.label :excerpt, "Excerpt", class: "mb-2 block text-sm font-semibold text-stone-700" %>
    <%= form.text_area :excerpt, rows: 3, class: "block w-full rounded-2xl border border-stone-200 bg-white/80 px-5 py-3 focus:border-orange-500 focus:outline-none focus:ring-4 focus:ring-orange-500/15" %>
  </div>

  <div>
    <%= form.label :cover_image, "Cover image", class: "mb-2 block text-sm font-semibold text-stone-700" %>
    <%= form.file_field :cover_image, accept: "image/*", class: "block w-full text-sm text-stone-600" %>
    <% if post.persisted? && post.cover_image.attached? %>
      <div class="mt-2"><%= image_tag post.cover_image, class: "h-32 rounded-xl object-cover" %></div>
    <% end %>
  </div>

  <div>
    <%= form.label :status, "Status", class: "mb-2 block text-sm font-semibold text-stone-700" %>
    <%= form.select :status, [["Draft","draft"],["Published","published"]], {}, class: "block w-full rounded-2xl border border-stone-200 bg-white/80 px-5 py-3 focus:border-orange-500 focus:outline-none focus:ring-4 focus:ring-orange-500/15" %>
  </div>

  <div>
    <%= form.label :category_id, "Category", class: "mb-2 block text-sm font-semibold text-stone-700" %>
    <%= form.collection_select :category_id, Category.order(:name), :id, :name, { include_blank: true }, class: "block w-full rounded-2xl border border-stone-200 bg-white/80 px-5 py-3 focus:border-orange-500 focus:outline-none focus:ring-4 focus:ring-orange-500/15" %>
  </div>

  <div>
    <%= form.label :tag_ids, "Tags", class: "mb-2 block text-sm font-semibold text-stone-700" %>
    <%= form.collection_check_boxes :tag_ids, Tag.order(:name), :id, :name do |b| %>
      <span class="mr-3 inline-flex items-center gap-1 text-sm">
        <%= b.check_box %> <%= b.label %>
      </span>
    <% end %>
  </div>

  <details class="rounded-2xl border border-stone-200 bg-stone-50/60 p-4">
    <summary class="cursor-pointer text-sm font-semibold text-stone-700">SEO</summary>
    <div class="mt-3 space-y-3">
      <%= form.label :seo_title, "SEO title", class: "block text-sm font-semibold text-stone-700" %>
      <%= form.text_field :seo_title, class: "block w-full rounded-2xl border border-stone-200 bg-white/80 px-5 py-3 focus:border-orange-500 focus:outline-none focus:ring-4 focus:ring-orange-500/15" %>
      <%= form.label :seo_description, "SEO description", class: "block text-sm font-semibold text-stone-700" %>
      <%= form.text_area :seo_description, rows: 2, class: "block w-full rounded-2xl border border-stone-200 bg-white/80 px-5 py-3 focus:border-orange-500 focus:outline-none focus:ring-4 focus:ring-orange-500/15" %>
    </div>
  </details>
  <div>
    <div class="mb-2 flex items-center justify-between">
      <%= form.label :content, "The story", class: "text-sm font-semibold text-stone-700" %>
      <span class="font-mono text-[11px] text-stone-400" data-post-form-target="wordCount">0 words · 1 min read</span>
    </div>
    <%= form.textarea :content, rows: 12, placeholder: "Once upon a deploy… write clearly, write honestly. Blank lines become paragraphs.",
      data: { post_form_target: "content", action: "input->post-form#update" },
      class: "block w-full resize-y rounded-2xl border border-stone-200 bg-white/80 px-5 py-4 leading-relaxed text-stone-800 shadow-sm backdrop-blur transition-all placeholder:text-stone-400 hover:border-stone-300 focus:border-orange-500 focus:outline-none focus:ring-4 focus:ring-orange-500/15" %>
    <p class="mt-2 text-xs text-stone-400">Tip: short paragraphs read best on screens. A blank line starts a new one.</p>
  </div>

  <div data-controller="attachment-upload">
    <div class="mb-2 flex items-center justify-between">
      <span class="text-sm font-semibold text-stone-700">Attachments</span>
      <span class="font-mono text-[11px] text-stone-400" data-attachment-upload-target="summary">No files selected</span>
    </div>

    <label data-attachment-upload-target="dropzone"
           data-action="dragover->attachment-upload#dragover dragleave->attachment-upload#dragleave drop->attachment-upload#drop"
           class="flex cursor-pointer flex-col items-center justify-center gap-2 rounded-2xl border-2 border-dashed border-stone-200 bg-stone-50/60 px-6 py-8 text-center transition-all hover:border-orange-300 hover:bg-orange-50/40">
      <svg class="h-8 w-8 text-stone-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M18.375 12.739l-7.693 7.693a4.5 4.5 0 01-6.364-6.364l10.94-10.94A3 3 0 1119.5 7.372L8.552 18.32m.009-.01l-.01.01m5.699-9.941l-7.81 7.81a1.5 1.5 0 002.112 2.13"/>
      </svg>
      <span class="text-sm font-medium text-stone-700">Drop files here or <span class="text-orange-600 underline decoration-orange-300 underline-offset-2">browse</span></span>
      <span class="text-xs text-stone-400">Images, PDFs or documents · up to 10 MB each</span>
      <%= form.file_field :attachments, multiple: true,
        data: { attachment_upload_target: "input", action: "change->attachment-upload#update" },
        class: "sr-only" %>
    </label>

    <ul class="mt-3 space-y-2" data-attachment-upload-target="list"></ul>

    <% if post.persisted? && post.attachments.attached? %>
      <div class="mt-5 rounded-2xl border border-stone-200 bg-white/70 p-4">
        <p class="font-mono text-[11px] uppercase tracking-[0.2em] text-stone-400">Already attached</p>
        <ul class="mt-3 space-y-2">
          <% post.attachments.each do |attachment| %>
            <li class="flex items-center gap-3 rounded-xl border border-stone-100 bg-stone-50/60 px-3 py-2.5">
              <svg class="h-4 w-4 shrink-0 text-stone-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M18.375 12.739l-7.693 7.693a4.5 4.5 0 01-6.364-6.364l10.94-10.94A3 3 0 1119.5 7.372L8.552 18.32m.009-.01l-.01.01m5.699-9.941l-7.81 7.81a1.5 1.5 0 002.112 2.13"/>
              </svg>
              <%= link_to attachment.filename.to_s, url_for(attachment), target: "_blank", rel: "noopener",
                class: "min-w-0 flex-1 truncate text-sm font-medium text-stone-700 transition-colors hover:text-orange-600" %>
              <span class="font-mono text-[10px] uppercase tracking-[0.16em] text-stone-400"><%= number_to_human_size(attachment.byte_size) %></span>
              <%= link_to "Remove", post_attachment_path(post, attachment),
                data: { turbo_method: :delete, turbo_confirm: "Remove #{attachment.filename}?" },
                class: "shrink-0 text-xs font-semibold text-stone-400 transition-colors hover:text-red-600" %>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </div>

  <div class="flex flex-col-reverse items-stretch gap-3 pt-2 sm:flex-row sm:items-center">
    <%= form.submit post.persisted? ? "Save changes" : "Publish story",
      class: "inline-flex cursor-pointer items-center justify-center gap-2 rounded-full bg-stone-900 px-8 py-3.5 text-sm font-semibold text-white shadow-xl shadow-stone-900/20 transition-all hover:-translate-y-0.5 hover:bg-orange-600 hover:shadow-orange-600/30 active:translate-y-0" %>
    <span class="hidden items-center gap-2 text-xs text-stone-400 sm:inline-flex">
      <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      Autosaved as draft in your browser
    </span>
  </div>
<% end %>
