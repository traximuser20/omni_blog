<% content_for :title, @post.title %>
<% content_for :head do %>
  <script type="application/ld+json">
    <%= raw({ "@context" => "https://schema.org", "@type" => "BlogPosting", "headline" => @post.title, "description" => @post.seo_description.presence || @post.excerpt, "datePublished" => @post.published_at&.iso8601, "dateModified" => @post.updated_at.iso8601, "author" => { "@type" => "Person", "name" => "OmniBlog Team" } }.to_json) %>
  </script>
<% end %>

<div class="mx-auto max-w-3xl animate-rise" data-controller="reading-progress">
  <!-- Progress bar -->
  <div class="fixed top-0 left-0 h-1 w-0 bg-orange-600 z-50 transition-all duration-300" data-reading-progress-target="progressBar"></div>

  <!-- Breadcrumb -->
  <nav class="flex items-center justify-between pt-10">
    <%= link_to posts_path, class: "group inline-flex items-center gap-2 rounded-full border border-stone-200 bg-white/80 px-4 py-2 text-sm font-medium text-stone-600 shadow-sm backdrop-blur transition-all hover:border-stone-900 hover:text-stone-900" do %>
      <svg class="h-4 w-4 transition-transform group-hover:-translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"/></svg>
      All stories
    <% end %>
    <div class="flex items-center gap-2">
      <%= link_to edit_post_path(@post), title: "Edit story", class: "grid h-9 w-9 place-items-center rounded-full border border-stone-200 bg-white/80 text-stone-500 shadow-sm backdrop-blur transition-all hover:border-stone-900 hover:text-stone-900" do %>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931z"/></svg>
      <% end %>
      <%= button_to @post, method: :delete, title: "Delete story", data: { turbo_confirm: "Delete “#{@post.title}”? This can't be undone." }, class: "grid h-9 w-9 cursor-pointer place-items-center rounded-full border border-stone-200 bg-white/80 text-stone-500 shadow-sm backdrop-blur transition-all hover:border-red-200 hover:bg-red-50 hover:text-red-600" do %>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0"/></svg>
      <% end %>
    </div>
  </nav>

  <!-- Header -->
  <header class="pt-10 text-center">
    <p class="flex items-center justify-center gap-3 font-mono text-[11px] uppercase tracking-[0.22em] text-stone-400">
      <span class="text-orange-600"><%= @post.created_at.strftime("%B %d, %Y") %></span>
      <span class="h-1 w-1 rounded-full bg-stone-300"></span>
      <span><%= reading_time(@post) %></span>
    </p>
    <h1 class="mx-auto mt-5 max-w-2xl font-display text-4xl font-semibold leading-[1.1] tracking-tight text-stone-900 sm:text-5xl"><%= @post.title %></h1>
    <% if @post.subtitle.present? %>
      <p class="mx-auto mt-3 max-w-2xl text-lg text-stone-500"><%= @post.subtitle %></p>
    <% end %>
    <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
      <% if @post.category %>
        <%= link_to @post.category.name, category_path(@post.category), class: "rounded-full bg-orange-100 px-3 py-1 text-xs font-semibold text-orange-700" %>
      <% end %>
      <% @post.tags.each do |t| %>
        <%= link_to "##{t.name}", tag_path(t), class: "rounded-full bg-stone-100 px-3 py-1 text-xs font-medium text-stone-600" %>
      <% end %>
    </div>
    <div class="mt-7 flex items-center justify-center gap-3">
      <span class="grid h-10 w-10 place-items-center rounded-full bg-stone-900 text-xs font-bold text-white"><%= author_initials(@post) %></span>
      <div class="text-left leading-tight">
        <p class="text-sm font-semibold text-stone-900">OmniBlog Team</p>
        <p class="text-xs text-stone-400">Updated <%= time_ago_in_words(@post.updated_at) %> ago</p>
      </div>
    </div>
  </header>

  <!-- Cover -->
  <div class="cover-texture mt-10 flex h-52 items-center justify-center rounded-3xl bg-gradient-to-br <%= cover_gradient(@post) %> shadow-xl sm:h-64">
    <span class="relative z-10 font-display text-8xl font-bold text-white/90 drop-shadow-lg sm:text-9xl"><%= @post.title.to_s.first&.upcase || "O" %></span>
  </div>

  <!-- Body -->
  <article class="mt-8 rounded-3xl border border-stone-200/80 bg-white p-8 shadow-xl shadow-stone-900/[0.05] sm:p-12">
    <div class="article-body">
      <%= simple_format(@post.content) %>
    </div>

    <div class="mt-10 flex items-center gap-3 border-t border-stone-100 pt-8">
      <span class="font-mono text-[11px] uppercase tracking-[0.2em] text-stone-400">Filed under</span>
      <span class="rounded-full bg-stone-900/[0.05] px-3.5 py-1.5 text-xs font-semibold text-stone-700">Journal</span>
      <span class="rounded-full bg-stone-900/[0.05] px-3.5 py-1.5 text-xs font-semibold text-stone-700">Rails</span>
      <span class="ml-auto hidden font-mono text-xs text-stone-400 sm:block"><%= @post.content.to_s.split.size %> words</span>
    </div>
  </article>

  <% if @post.attachments.attached? %>
    <!-- Attachments -->
    <section class="mt-8 rounded-3xl border border-stone-200/80 bg-white/80 p-8 shadow-xl shadow-stone-900/[0.05] backdrop-blur sm:p-12" aria-labelledby="attachments-heading">
      <div class="flex items-end justify-between gap-3">
        <h2 id="attachments-heading" class="font-display text-2xl font-semibold tracking-tight text-stone-900">Attachments</h2>
        <span class="rounded-full bg-stone-900/[0.05] px-3 py-1 font-mono text-[11px] uppercase tracking-[0.18em] text-stone-500">
          <%= pluralize(@post.attachments.size, "file") %>
        </span>
      </div>

      <div class="mt-6 grid gap-3 sm:grid-cols-2">
        <% @post.attachments.each do |attachment| %>
          <% if attachment.image? %>
            <%= link_to url_for(attachment), target: "_blank", rel: "noopener",
              class: "group overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm transition-all hover:-translate-y-0.5 hover:border-orange-200 hover:shadow-lg" do %>
              <%= image_tag url_for(attachment), alt: attachment.filename.to_s, loading: "lazy",
                class: "h-44 w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]" %>
              <div class="flex items-center justify-between gap-3 px-4 py-3">
                <p class="truncate text-sm font-medium text-stone-700"><%= attachment.filename %></p>
                <span class="shrink-0 font-mono text-[10px] uppercase tracking-[0.16em] text-stone-400"><%= number_to_human_size(attachment.byte_size) %></span>
              </div>
            <% end %>
          <% else %>
            <%= link_to url_for(attachment), target: "_blank", rel: "noopener",
              class: "group flex items-center gap-3 rounded-2xl border border-stone-200 bg-white px-4 py-3.5 shadow-sm transition-all hover:-translate-y-0.5 hover:border-orange-200 hover:shadow-lg" do %>
              <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-stone-900/[0.05] text-stone-500 transition-colors group-hover:bg-orange-50 group-hover:text-orange-600">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/>
                </svg>
              </span>
              <span class="min-w-0 flex-1">
                <span class="block truncate text-sm font-medium text-stone-700 transition-colors group-hover:text-orange-700"><%= attachment.filename %></span>
                <span class="font-mono text-[10px] uppercase tracking-[0.16em] text-stone-400"><%= number_to_human_size(attachment.byte_size) %></span>
              </span>
              <svg class="h-4 w-4 shrink-0 text-stone-300 transition-colors group-hover:text-orange-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/>
              </svg>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </section>
  <% end %>

  <!-- Engagement -->
  <div class="mt-8 flex items-center justify-center gap-4">
    <% if user_signed_in? %>
      <% if current_user.liked_posts.include?(@post) %>
        <%= button_to "Unlike (#{@post.post_likes.count})", post_like_path(@post), method: :delete, class: "rounded-full border border-rose-200 bg-rose-50 px-5 py-2.5 text-sm font-semibold text-rose-600 hover:bg-rose-100" %>
      <% else %>
        <%= button_to "Like (#{@post.post_likes.count})", post_like_path(@post), method: :post, class: "rounded-full border border-stone-200 bg-white px-5 py-2.5 text-sm font-semibold text-stone-700 hover:border-rose-300 hover:text-rose-600" %>
      <% end %>
      <% if current_user.bookmarked_posts.include?(@post) %>
        <%= button_to "Remove bookmark", post_bookmark_path(@post), method: :delete, class: "rounded-full border border-amber-200 bg-amber-50 px-5 py-2.5 text-sm font-semibold text-amber-700 hover:bg-amber-100" %>
      <% else %>
        <%= button_to "Bookmark", post_bookmark_path(@post), method: :post, class: "rounded-full border border-stone-200 bg-white px-5 py-2.5 text-sm font-semibold text-stone-700 hover:border-amber-300 hover:text-amber-700" %>
      <% end %>
    <% else %>
      <span class="text-sm text-stone-500">Like count: <%= @post.post_likes.count %></span>
      <%= link_to "Sign in to like/bookmark", new_user_session_path, class: "rounded-full bg-stone-900 px-5 py-2.5 text-sm font-semibold text-white" %>
    <% end %>
  </div>

  <!-- Comments -->
  <section class="mt-8 rounded-3xl border border-stone-200/80 bg-white/80 p-8 shadow-xl shadow-stone-900/[0.05] backdrop-blur sm:p-12" aria-labelledby="comments-heading">
    <div class="flex items-end justify-between gap-3">
      <h2 id="comments-heading" class="font-display text-2xl font-semibold tracking-tight text-stone-900">Comments</h2>
      <span class="rounded-full bg-stone-900/[0.05] px-3 py-1 font-mono text-[11px] uppercase tracking-[0.18em] text-stone-500">
        <%= pluralize(@comments.size, "comment") %>
      </span>
    </div>

    <% if @comments.any? %>
      <div class="mt-6 space-y-3">
        <%= render @comments %>
      </div>
    <% else %>
      <p class="mt-6 rounded-2xl border border-dashed border-stone-200 bg-stone-50/60 px-5 py-6 text-center text-sm text-stone-500">
        No comments yet — be the first to share a thought.
      </p>
    <% end %>

    <div class="mt-8 border-t border-stone-100 pt-8">
      <% if user_signed_in? %>
        <%= render "comments/form", post: @post, comment: @comment %>
      <% else %>
        <div class="flex flex-col items-center justify-between gap-4 rounded-2xl border border-stone-200 bg-stone-50/60 px-5 py-5 text-center sm:flex-row sm:text-left">
          <p class="text-sm text-stone-600">
            <span class="font-semibold text-stone-900">Join the conversation.</span>
            Sign in to leave a comment.
          </p>
          <%= link_to "Sign in to comment", new_user_session_path, class: "shrink-0 rounded-full bg-stone-900 px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-stone-900/20 transition-all hover:-translate-y-0.5 hover:bg-orange-600" %>
        </div>
      <% end %>
    </div>
  </section>

  <!-- Footer actions -->
  <footer class="mt-8 flex flex-col items-center justify-between gap-4 rounded-3xl border border-stone-200/80 bg-white/70 px-6 py-5 backdrop-blur sm:flex-row">
    <%= link_to posts_path, class: "group inline-flex items-center gap-2 text-sm font-semibold text-stone-900" do %>
      <svg class="h-4 w-4 transition-transform group-hover:-translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"/></svg>
      Back to all stories
    <% end %>
    <div class="flex items-center gap-3">
      <%= link_to "Edit story", edit_post_path(@post), class: "rounded-full border border-stone-300 px-5 py-2.5 text-sm font-semibold text-stone-700 transition-all hover:border-stone-900 hover:text-stone-900" %>
      <%= link_to "Write new", new_post_path, class: "rounded-full bg-stone-900 px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-stone-900/20 transition-all hover:-translate-y-0.5 hover:bg-orange-600" %>
    </div>
  </footer>

  <% more = Post.where.not(id: @post.id).order(created_at: :desc).limit(3) %>
  <% if more.any? %>
    <section class="mt-14">
      <div class="mb-6 flex items-end justify-between">
        <h2 class="font-display text-2xl font-semibold tracking-tight">Keep reading</h2>
        <%= link_to "View all →", posts_path, class: "text-sm font-semibold text-stone-500 transition-colors hover:text-orange-600" %>
      </div>
      <div class="grid gap-6 sm:grid-cols-3">
        <% more.each do |p| %>
          <%= link_to p, class: "group rounded-2xl border border-stone-200/80 bg-white p-5 shadow-sm transition-all hover:-translate-y-1 hover:shadow-lg" do %>
            <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-orange-600"><%= p.created_at.strftime("%b %d, %Y") %></p>
            <h3 class="mt-2 font-display text-lg font-semibold leading-snug tracking-tight line-clamp-2 transition-colors group-hover:text-orange-700"><%= p.title %></h3>
            <p class="mt-2 text-sm leading-relaxed text-stone-500 line-clamp-2"><%= post_excerpt(p, 110) %></p>
          <% end %>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
