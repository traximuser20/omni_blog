<% content_for :title, "Write a new story" %>

<div class="mx-auto max-w-3xl animate-rise">
  <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-orange-600">New story</p>
  <h1 class="mt-2 font-display text-4xl font-semibold tracking-tight text-stone-900 sm:text-5xl">Write something<br>worth reading.</h1>
  <p class="mt-3 max-w-lg text-stone-500">Give it a headline that earns the click, then the words that keep the reader.</p>

  <div class="mt-8 rounded-3xl border border-stone-200/80 bg-white/80 p-6 shadow-xl shadow-stone-900/[0.05] backdrop-blur sm:p-10">
    <%= render "form", post: @post %>
  </div>

  <div class="mt-6 text-center">
    <%= link_to "← Back to all stories", posts_path, class: "text-sm font-medium text-stone-500 transition-colors hover:text-stone-900" %>
  </div>
</div>
