<% content_for :title, "Categories" %>
<section class="pt-10">
  <h1 class="font-display text-4xl font-semibold tracking-tight">Categories</h1>
  <p class="mt-2 text-stone-500">Browse stories by topic.</p>
  <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% @categories.each do |c| %>
      <%= link_to category_path(c), class: "rounded-2xl border border-stone-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg" do %>
        <h2 class="font-display text-xl font-semibold"><%= c.name %></h2>
        <p class="mt-1 text-sm text-stone-500"><%= c.description %></p>
        <p class="mt-3 font-mono text-xs text-stone-400"><%= pluralize(c.posts.published.count, "story") %></p>
      <% end %>
    <% end %>
  </div>
</section>
