<div class="mx-auto mt-10 max-w-md rounded-3xl border border-stone-200 bg-white p-8 shadow-xl shadow-stone-900/[0.06]">
  <h2 class="font-display text-2xl font-semibold text-stone-900">Log in</h2>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "mt-6 space-y-5" }) do |f| %>
    <div class="field">
      <%= f.label :email, class: "block text-sm font-medium text-stone-700" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "mt-1 block w-full rounded-xl border border-stone-300 px-4 py-2.5 text-sm shadow-sm focus:border-orange-500 focus:ring-orange-500" %>
    </div>

    <div class="field">
      <%= f.label :password, class: "block text-sm font-medium text-stone-700" %>
      <%= f.password_field :password, autocomplete: "current-password", class: "mt-1 block w-full rounded-xl border border-stone-300 px-4 py-2.5 text-sm shadow-sm focus:border-orange-500 focus:ring-orange-500" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="flex items-center gap-2">
        <%= f.check_box :remember_me, class: "rounded border-stone-300 text-orange-600 focus:ring-orange-500" %>
        <%= f.label :remember_me, class: "text-sm text-stone-600" %>
      </div>
    <% end %>

    <div class="actions">
      <%= f.submit "Log in", class: "w-full cursor-pointer rounded-full bg-stone-900 px-5 py-2.5 text-sm font-semibold text-white shadow-lg transition-all hover:-translate-y-0.5 hover:bg-orange-600" %>
    </div>
  <% end %>

  <div class="mt-6 text-sm text-stone-500">
    <%= render "devise/shared/links" %>
  </div>
</div>
