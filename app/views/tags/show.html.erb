<% content_for :title, "##{@tag.name}" %>
<section class="pt-10">
  <h1 class="font-display text-4xl font-semibold tracking-tight">#<%= @tag.name %></h1>
  <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    <%= render @posts %>
  </div>
  <% if @posts.empty? %>
    <p class="mt-8 text-stone-500">No published stories yet.</p>
  <% end %>
</section>
